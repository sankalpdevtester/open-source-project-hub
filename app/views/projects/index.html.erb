<h1>Project Showcase</h1>

<div class="row">
  <% @projects.each do |project| %>
    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title"><%= project.name %></h5>
          <p class="card-text"><%= project.description %></p>
          <a href="<%= project.url %>" class="btn btn-primary">Visit Project</a>
        </div>
      </div>
    </div>
  <% end %>
</div>